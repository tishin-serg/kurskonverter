# Bybit official route requires API credentials and P2P advertiser access.
DATA_MODE=live
TELEGRAM_BOT_TOKEN=
SQLITE_PATH=data/bot.db
HTTP_ADDR=:8080
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
WALLET_API_KEY=
BESTCHANGE_API_KEY=
# All provider keys above are consumed; only read operations are performed.
BYBIT_P2P_SOURCE=official
# Optional explicit zero taker-fee fallback for RUB/USDT if API fields are empty.
# Quotes are always marked degraded. Empty = fail closed.
BYBIT_P2P_TAKER_FEE_FALLBACK=
MIN_COMPLETION_RATE=95
MIN_ORDERS_COUNT=50
PAYMENT_METHOD=
BYBIT_P2P_REFRESH=20s
WALLET_P2P_REFRESH=30s
BESTCHANGE_REFRESH=20s
FEE_REFRESH=5m
ORDERBOOK_REFRESH=5s
GOMEMLIMIT=384MiB
GOMAXPROCS=1
# Optional published Wallet withdrawal tariff (GRAM); empty disables the route.
# Published 0.05 GRAM on 2026-09-07. Always degraded: verify in Wallet.
WALLET_GRAM_WITHDRAWAL_FEE_FALLBACK=
# Default: TCSBRUB for PAYMENT_METHOD=Tbank, otherwise SBPRUB.
# Use the exact non-cash RUB currency code from the official API.
BESTCHANGE_FROM_CODE=

